<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WhatsAppStickerMaker" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_whatsapp</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <item name="android:colorBackground">@color/background_light</item>
        <item name="android:windowBackground">@color/background_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/card_stroke</item>
        
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/background_light</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Dialog Theme -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.WhatsAppStickerMaker.Dialog</item>
    </style>

    <style name="ThemeOverlay.WhatsAppStickerMaker.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorPrimary">@color/accent_whatsapp</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.WhatsAppStickerMaker.DialogCorner</item>
    </style>

    <style name="ShapeAppearance.WhatsAppStickerMaker.DialogCorner" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">24dp</item>
    </style>
</resources>
