<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvPreviewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalle del Sticker"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/thumbnail_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/imgPreviewSticker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="12dp"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_sticker_pack" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvStickerInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        tools:text="Sticker animado WebP" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical">

        <!-- Set as Pack Tray Icon -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetAsTrayIcon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/tonal_green_bg"
            android:paddingVertical="11dp"
            android:text="🌟 Usar como ícono del paquete"
            android:textColor="@color/tonal_green_text"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_star"
            app:iconGravity="textStart"
            app:iconTint="@color/tonal_green_text" />

        <!-- Share single sticker -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareSingleSticker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/surface_light"
            android:paddingVertical="11dp"
            android:text="📤 Compartir este sticker"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_share"
            app:iconGravity="textStart"
            app:iconTint="@color/text_primary"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp" />

        <!-- Delete sticker -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteSingleSticker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#26E53E3E"
            android:paddingVertical="11dp"
            android:text="🗑️ Eliminar sticker"
            android:textColor="#E53E3E"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_delete"
            app:iconGravity="textStart"
            app:iconTint="#E53E3E" />

    </LinearLayout>

</LinearLayout>
