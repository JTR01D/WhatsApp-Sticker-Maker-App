<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/bg_liquid_glass_appbar"
            app:elevation="0dp"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/white"
            app:title="Detalle del Paquete"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
            app:titleTextColor="@color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Pack Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_light"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imgDetailTray"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:background="@color/thumbnail_bg"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_sticker_pack"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvDetailPackName"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textColor="@color/text_primary"
                                    android:textSize="19sp"
                                    android:textStyle="bold"
                                    tools:text="Mis Stickers" />

                                <ImageButton
                                    android:id="@+id/btnEditPackName"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="Editar nombre"
                                    android:padding="4dp"
                                    android:src="@drawable/ic_edit"
                                    app:tint="@color/text_secondary" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvDetailPublisher"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                tools:text="Por Juan" />

                            <LinearLayout
                                android:id="@+id/layoutStatusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_badge_rounded"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp">

                                <TextView
                                    android:id="@+id/tvDetailStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/badge_warning"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    tools:text="Faltan 3 stickers para el mínimo" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetailAddToWhatsApp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/btn_whatsapp_bg"
                        android:paddingVertical="13dp"
                        android:text="@string/add_to_whatsapp"
                        android:textColor="@color/btn_whatsapp_text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_whatsapp"
                        app:iconGravity="textStart"
                        app:iconTint="@color/btn_whatsapp_text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportZip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="@color/tonal_green_bg"
                        android:paddingVertical="11dp"
                        android:text="📦 Compartir Paquete (.zip)"
                        android:textColor="@color/tonal_green_text"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_share"
                        app:iconGravity="textStart"
                        app:iconTint="@color/tonal_green_text"
                        app:strokeColor="@color/accent_whatsapp"
                        app:strokeWidth="1dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Import Options Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardImportOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface_light"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📥 Importar Stickers (.webp o .zip)"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Agrega stickers desde WhatsApp Oficial o desde el almacenamiento:"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <!-- Primary WhatsApp Official Import Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnImportWhatsApp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="@color/tonal_green_bg"
                        android:paddingVertical="11dp"
                        android:text="💬 WhatsApp Stickers Oficial (Detectar)"
                        android:textColor="@color/tonal_green_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_whatsapp"
                        app:iconGravity="textStart"
                        app:iconTint="@color/tonal_green_text"
                        app:strokeColor="@color/accent_whatsapp"
                        app:strokeWidth="1dp" />

                    <!-- Folder, Files, and ZIP Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnImportFolder"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="3dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/tonal_green_bg"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:maxLines="1"
                            android:ellipsize="none"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="9dp"
                            android:text="Carpeta"
                            android:textColor="@color/tonal_green_text"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_folder"
                            app:iconGravity="textStart"
                            app:iconPadding="3dp"
                            app:iconSize="16dp"
                            app:iconTint="@color/tonal_green_text" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnImportFiles"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/tonal_green_bg"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:maxLines="1"
                            android:ellipsize="none"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="9dp"
                            android:text="Archivos"
                            android:textColor="@color/tonal_green_text"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_photo"
                            app:iconGravity="textStart"
                            app:iconPadding="3dp"
                            app:iconSize="16dp"
                            app:iconTint="@color/tonal_green_text" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnImportZip"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/tonal_green_bg"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:maxLines="1"
                            android:ellipsize="none"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="9dp"
                            android:text="ZIP"
                            android:textColor="@color/tonal_green_text"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_archive"
                            app:iconGravity="textStart"
                            app:iconPadding="3dp"
                            app:iconSize="16dp"
                            app:iconTint="@color/tonal_green_text" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Loading indicator for image conversion -->
            <LinearLayout
                android:id="@+id/layoutProcessing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/tonal_green_bg"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ProgressBar
                        android:id="@+id/progressSpinner"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/accent_whatsapp" />

                    <TextView
                        android:id="@+id/tvProcessingStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Procesando archivos .webp…"
                        android:textColor="@color/tonal_green_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressBarImport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progress="0"
                    app:indicatorColor="@color/accent_whatsapp"
                    app:trackColor="@color/card_stroke" />

            </LinearLayout>

            <!-- Section Title & Management -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Stickers en este paquete"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:text="3 / 30" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManageStickers"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="Seleccionar"
                    android:textColor="@color/accent_whatsapp"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Sticker Batch Selection Actions Bar -->
            <LinearLayout
                android:id="@+id/layoutStickerSelectionActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/tonal_green_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvStickerSelectionCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 seleccionados"
                    android:textColor="@color/tonal_green_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectAllStickers"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Todos"
                    android:textColor="@color/tonal_green_text"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteSelectedStickers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#E53E3E"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Eliminar"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />

                <ImageButton
                    android:id="@+id/btnCloseStickerSelection"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Cerrar"
                    android:src="@drawable/ic_close"
                    app:tint="@color/tonal_green_text" />

            </LinearLayout>

            <!-- Stickers Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewStickers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="6"
                tools:listitem="@layout/item_sticker" />

            <!-- Empty State for Stickers -->
            <LinearLayout
                android:id="@+id/layoutEmptyStickers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_circle_tinted"
                    android:contentDescription="@null"
                    android:padding="16dp"
                    android:src="@drawable/ic_sticker_pack"
                    app:tint="@color/accent_whatsapp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="No hay stickers en este paquete"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Importa desde WhatsApp Oficial, una carpeta o archivos para agregarlos a WhatsApp (mínimo 3)."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Bottom spacing so stickers are never blocked by FAB -->
            <View
                android:layout_width="match_parent"
                android:layout_height="110dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- FAB to Add Stickers from device storage (auto-hides on scroll) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddStickers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:backgroundTint="@color/accent_whatsapp"
        android:contentDescription="@string/add_stickers"
        android:elevation="6dp"
        app:tint="@color/fab_tint"
        app:srcCompat="@drawable/ic_add"
        app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
