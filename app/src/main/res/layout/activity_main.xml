<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <FrameLayout
            android:id="@+id/topBarContainer"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_liquid_glass_appbar"
            android:paddingHorizontal="16dp">

            <!-- Normal Title & Badge Header -->
            <LinearLayout
                android:id="@+id/layoutNormalHeader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvToolbarTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/toolbar_title"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPacksFilterBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="0 paquetes"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Search Button -->
                <FrameLayout
                    android:id="@+id/btnSearchPacks"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_dialog_icon_squircle"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="Buscar"
                        android:src="@drawable/ic_search"
                        app:tint="@color/white" />
                </FrameLayout>

            </LinearLayout>

            <!-- Search Mode Header -->
            <LinearLayout
                android:id="@+id/layoutSearchHeader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Buscar"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_secondary" />

                <EditText
                    android:id="@+id/etSearchPacks"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/btnCloseSearch"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Cerrar Búsqueda"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/white" />

            </LinearLayout>

        </FrameLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- RecyclerView of Packs -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewPacks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="115dp"
            tools:listitem="@layout/item_pack" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layoutEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_circle_tinted"
                android:contentDescription="@null"
                android:padding="20dp"
                android:src="@drawable/ic_sticker_pack"
                app:tint="@color/accent_whatsapp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/empty_packs_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/empty_packs_desc"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyCreate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/btn_whatsapp_bg"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp"
                android:text="@string/create_new_pack"
                android:textColor="@color/btn_whatsapp_text"
                android:textStyle="bold"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_add"
                app:iconTint="@color/btn_whatsapp_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyImportZip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/tonal_green_bg"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp"
                android:text="Importar Paquete (.zip)"
                android:textColor="@color/tonal_green_text"
                android:textStyle="bold"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_archive"
                app:iconTint="@color/tonal_green_text" />

        </LinearLayout>

    </FrameLayout>

    <!-- Floating Bottom Navigation Dock (DJI Mimo Style) -->
    <LinearLayout
        android:id="@+id/layoutDjiBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="20dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Main Navigation Capsule -->
        <LinearLayout
            android:id="@+id/cardDjiDock"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dji_floating_dock"
            android:elevation="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <!-- Tab 1: Todos los Paquetes -->
            <FrameLayout
                android:id="@+id/tabDjiAll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <View
                    android:id="@+id/indicatorDjiAll"
                    android:layout_width="52dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_dji_tab_indicator"
                    android:visibility="visible" />

                <ImageView
                    android:id="@+id/iconDjiAll"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/tab_all"
                    android:src="@drawable/ic_home"
                    app:tint="@color/white" />
            </FrameLayout>

            <!-- Tab 2: Paquetes Estáticos -->
            <FrameLayout
                android:id="@+id/tabDjiStatic"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <View
                    android:id="@+id/indicatorDjiStatic"
                    android:layout_width="52dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_dji_tab_indicator"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iconDjiStatic"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/tab_static"
                    android:src="@drawable/ic_photo"
                    app:tint="#94A3B8" />
            </FrameLayout>

            <!-- Tab 3: Paquetes Animados -->
            <FrameLayout
                android:id="@+id/tabDjiAnimated"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <View
                    android:id="@+id/indicatorDjiAnimated"
                    android:layout_width="52dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_dji_tab_indicator"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iconDjiAnimated"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/tab_animated"
                    android:src="@drawable/ic_movie"
                    app:tint="#94A3B8" />
            </FrameLayout>

            <!-- Tab 4: Opciones & Herramientas -->
            <FrameLayout
                android:id="@+id/tabDjiMore"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <View
                    android:id="@+id/indicatorDjiMore"
                    android:layout_width="52dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_dji_tab_indicator"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iconDjiMore"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/tab_more"
                    android:src="@drawable/ic_more_vert"
                    app:tint="#94A3B8" />
            </FrameLayout>

        </LinearLayout>

        <!-- Independent Circular Action Button (DJI Action Button Style) -->
        <FrameLayout
            android:id="@+id/btnDjiAction"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_dji_floating_circle"
            android:clickable="true"
            android:elevation="12dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="Crear Paquete"
                android:src="@drawable/ic_add"
                app:tint="@color/white" />
        </FrameLayout>

    </LinearLayout>

    <!-- Floating Bottom Selection Bar for Packs -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPacksSelectionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="#E81C2636"
        app:cardCornerRadius="24dp"
        app:cardElevation="14dp"
        app:strokeColor="#3DFFFFFF"
        app:strokeWidth="1.2dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <!-- Fila superior: Cerrar, Contador con ancho completo, botón Todos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnClosePacksSelection"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Cerrar selección"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvSelectedPacksCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="3 seleccionados" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectAllPacks"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="Todos"
                    android:textColor="@color/accent_whatsapp"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Fila inferior: Botones de Acción Liquid Glass (Añadir a WhatsApp & Borrar) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddSelectedToWhatsApp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:background="@drawable/bg_liquid_glass_button_primary"
                    android:paddingVertical="10dp"
                    android:text="Añadir a WhatsApp"
                    android:textColor="@color/btn_whatsapp_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_whatsapp"
                    app:iconGravity="textStart"
                    app:iconTint="@color/btn_whatsapp_text" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteSelectedPacks"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_liquid_glass_button_danger"
                    android:paddingVertical="10dp"
                    android:text="Borrar"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_delete"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
